*.log
*.out
*.help.txt
*.usage.txt
*.kem.sk.bin
*.cert.bin
*.key
*.pem
*.public.json
*.candidate.json
metrics*.txt
disk_files.txt
workflow.lf.yml
workflow.nocomment.yml
