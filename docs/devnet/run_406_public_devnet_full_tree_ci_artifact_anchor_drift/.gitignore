# Run 406 evidence archive — only README.md, summary.txt, and .gitignore are tracked.
# All per-run artifacts contain absolute paths and ephemeral data and MUST NOT be committed.
# Only publish-safe document/manifest hashes and OK/POSITIVE status lines appear in the tracked summary.
# The full-tree manifest, anchor-drift report, and CI summary are generated transiently OUTSIDE
# the package tree (runner temp / staging) and are never committed.
material/
node/
nodes/
logs/
data/
artifact-staging/
