+#[cfg(any(test, feature = "test-utils"))]
+pub fn size_of_prepared_registry_cell() -> usize {
+    std::mem::size_of::<Mutex<PreparedRegistry>>()
+}
+
+/// Test-only: `size_of` the owning [`PreparedPin`] guard value.
