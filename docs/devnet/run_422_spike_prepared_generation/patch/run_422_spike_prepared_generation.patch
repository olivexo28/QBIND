+                    return Err((proof, CaptureRefusal::Admission(e)));
+                }
+            };
+            // Reserve the generation-only charge while the proof holder is live.
+            let gen_res = match self.backend.accounting().reserve(gen_charge) {
+                Ok(r) => r,
+                Err(e) => {
+                    drop(entry_res);
+                    return Err((proof, CaptureRefusal::Admission(e)));
+                }
+            };
