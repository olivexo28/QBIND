+/// The **generation-only** retained-memory charge for a prepared-decision L0
+/// entry (§ 13.6), measured in place from the live retained generation **without
+/// cloning** it.
+///
+/// This mirrors [`generation_charge`] but reads the evidence backings directly
+/// from the live [`RetainedRecord`] a captured proof moved into the registry,
+/// rather than from a separately-built [`RetainedGeneration`] wrapper (whose
+/// `from_locked` constructor *clones* the evidence into a second representation
+/// whose capacities are the clone's, not the live object's). It charges the
+/// inline generation wrapper + the actual capacity-measured evidence backings +
+/// the shared-allocation overhead once, and is always
+/// `<= MAX_RETAINED_GENERATION_BYTES` — so a prepared generation consumes one of
+/// the generations the aggregate's `gen_term` already budgets, with no ceiling
+/// increase. A `BootstrapNoLock` record is refused (prepared retention is a
+/// Locked-only experiment).
+pub fn prepared_generation_charge(
+    ctx: &PinnedSafetyContext,
+    retained: &RetainedRecord,
+) -> Result<u128, SafetyStoreError> {
+    let evidence = match &retained.record {
+        SafetyRecord::Locked(l) => &l.evidence,
+        SafetyRecord::BootstrapNoLock { .. } => {
+            return Err(SafetyStoreError::StructuralRefusal(
+                super::error::StructuralRefusalDetail::Static(
+                    "prepared generation charge requires a Locked generation",
+                ),
+            ));
+        }
+    };
+    let mut total = add(size_of_retained_generation(), evidence_backing_capacity(evidence)?)?;
+    total = add(total, ARC_CTRL)?;
+    let cap = max_retained_generation_bytes(ctx, size_of_timeout_msg())?;
+    if total > cap {
+        return Err(SafetyStoreError::DeclaredBoundExceeded(
+            DeclaredBoundDetail::GenerationChargeExceeds { charge: total, cap },
+        ));
+    }
+    Ok(total)
+}
