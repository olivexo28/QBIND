# metrics dumps are temporary and dev-only; only published-safe hashes/short ids appear in
# the tracked summary/README.
material/
node-data/
node-data-neg/
nodes/
logs/
data/
*.public.json
*.candidate.json
*.err
*.log
*.cert.bin
*.kem.sk.bin
*.spec
*.hex
public-identity.json