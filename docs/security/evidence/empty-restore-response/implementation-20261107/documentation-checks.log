import hashlib
import re
import subprocess
from pathlib import Path

BASE = "30a79a21996c11f97f1c496082551dba4cbd3a45"
MAIN = "541d9a6c9a43fe10410260d9c2494a5fc4416c7a"
BRANCH = "investigation/empty-restore-response-20261107"
PACKAGE = Path("docs/security/evidence/empty-restore-response/implementation-20261107")
PLAN = "docs/security/QBIND_AUDIT_REMEDIATION_PLAN.md"
SOURCE = "crates/qbind-node/src/binary_consensus_loop.rs"
METRICS = "crates/qbind-node/src/metrics.rs"


def git(*args):
    return subprocess.run(
        ["git", *args], check=True, capture_output=True
    ).stdout


def blob(rev, path):
    return git("show", f"{rev}:{path}")


assert git("branch", "--show-current").decode().strip() == BRANCH
assert git("rev-parse", "HEAD").decode().strip() == BASE
assert git("rev-parse", f"{BASE}^{{tree}}").decode().strip() == "d903a8671192f09be763fdb6c11b7ad4c883d62e"
assert git("rev-parse", f"{MAIN}^{{tree}}").decode().strip() == "0b0e597a29dc8f2d95d93f9bd04364cc140a9db1"
git("merge-base", "--is-ancestor", MAIN, BASE)
remote = git("ls-remote", "origin", "refs/heads/main", f"refs/heads/{BRANCH}").decode()
assert f"{MAIN}\trefs/heads/main\n" in remote
assert f"{BASE}\trefs/heads/{BRANCH}\n" in remote
print("PASS: branch/base/tree/ancestry and direct remote refs")
print(remote, end="")

plan_before = blob(BASE, PLAN)
assert Path(PLAN).read_bytes().startswith(plan_before)
print(f"PASS: unchanged starting plan prefix: {len(plan_before)} bytes, SHA256 {hashlib.sha256(plan_before).hexdigest()}")
historical = git("ls-tree", "-r", "--name-only", BASE, "docs/security/evidence/empty-restore-response").decode().splitlines()
for path in historical:
    old = blob(BASE, path)
    assert Path(path).read_bytes() == old, path
    print(f"PASS historical byte identity: {hashlib.sha256(old).hexdigest()}  {path}")
for rev, manifest in [
    ("fb29cef67ba4d7c918f4299a9b60de79cd6f41ef", "docs/security/evidence/empty-restore-response/SHA256SUMS"),
    (BASE, "docs/security/evidence/empty-restore-response/containment-contract-20261107/SHA256SUMS"),
]:
    lines = blob(rev, manifest).decode().splitlines()
    for line in lines:
        digest, path = line.split("  ", 1)
        assert hashlib.sha256(blob(rev, path)).hexdigest() == digest, (rev, path)
    print(f"PASS: {len(lines)} historical manifest entries verified at producing revision {rev}")

old_source = blob(BASE, SOURCE).decode()
source = Path(SOURCE).read_bytes().decode()


def nonempty_guard(text):
    arm = text.index("ConsensusNetMsg::RestoreCatchupResponse(resp) =>")
    start = text.index("if !resp.blocks.is_empty() {", arm)
    end = start
    depth = 0
    for end in range(text.index("{", start), len(text)):
        if text[end] == "{":
            depth += 1
        elif text[end] == "}":
            depth -= 1
            if depth == 0:
                return text[start:end + 1]
    raise AssertionError("guard end not found")


assert nonempty_guard(old_source) == nonempty_guard(source)
old_helper = old_source[old_source.index("fn handle_restore_catchup_response("):old_source.index("fn evaluate_restore_mode_transition(")]
helper = source[source.index("fn handle_restore_catchup_response("):source.index("fn evaluate_restore_mode_transition(")]
assert helper == old_helper
old_binding = old_source[old_source.index("let bind_sender ="):old_source.index("stats.inbound_msgs_received =")]
binding = source[source.index("let bind_sender ="):source.index("stats.inbound_msgs_received =")]
assert binding == old_binding
print("PASS: non-empty guard, direct-helper body and binding closure unchanged byte-for-byte")

